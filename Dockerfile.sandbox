FROM python:3.12-slim

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates gnupg && \
    # Node.js 20 via NodeSource
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# Python static-analysis tools
RUN pip install --no-cache-dir semgrep bandit

# Hadolint (Dockerfile linter)
RUN curl -sSL -o /usr/local/bin/hadolint \
        https://github.com/hadolint/hadolint/releases/download/v2.12.0/hadolint-Linux-x86_64 && \
    chmod +x /usr/local/bin/hadolint

# AI CLI tools
RUN npm install -g @anthropic-ai/claude-code @openai/codex

# Directories the sandbox expects
RUN mkdir -p /workspace /tools /results

ARG UID=1000
ARG GID=1000

# Non-root user — UID/GID injected at build time to match the host user,
# so tools inside the container (git, npm, Claude Code) can resolve the
# current user via /etc/passwd even when UID != 1000.
RUN if ! getent group  ${GID}  >/dev/null 2>&1; then groupadd -g ${GID} sandbox; fi && \
    if ! getent passwd ${UID}  >/dev/null 2>&1; then useradd -m -u ${UID} -g ${GID} -d /home/user sandbox; fi
USER ${UID}:${GID}

WORKDIR /workspace
